# ============================================================
# WattPulse — Environment Configuration
# Copy this file to .env and fill in your values.
# On PandaStack, set these in the dashboard instead of using .env.
# ============================================================

# ===== DATABASE (PandaStack injects these when a managed DB is attached) =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=ev_charging_db

# ===== EMAIL (OTP via Gmail SMTP) =====
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# ===== PAYMENT GATEWAY (Khalti) =====
PAYMENT_DRIVER=simulated
KHALTI_BASE_URL=https://dev.khalti.com/api/v2/
KHALTI_SECRET_KEY=

# ===== GOOGLE OAUTH =====
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

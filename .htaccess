<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /EE/
    
    # Prioritize index.php over index.html
    DirectoryIndex index.php index.html
    
    # Disable directory listing
    Options -Indexes
    
    # Block dev-only directories outright: tests/ (destructive live-DB test
    # runner, session cookie jars, audit docs) and logs/ (app logs).
    # Primary gate: mod_rewrite [F] — path-scoped, works on Apache 2.2 AND 2.4
    # (mod_rewrite is already required by this file's rewrite block).
    RewriteRule ^(tests|logs)(/|$) - [F,L]
    
    # Allow direct access to files and folders
    # Prevent rewrite loop: don't rewrite if already pointing into public/
    RewriteCond %{REQUEST_URI} !^/EE/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Redirect all requests to public folder
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block access to sensitive files — dual syntax: modern Apache 2.4 authz
# (mod_authz_core) with legacy 2.2 Order/Deny fallback, so the deny holds
# whichever authz module stack is loaded.
<IfModule mod_authz_core.c>
    <FilesMatch "\.(env|json|sql|log)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(env|json|sql|log)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Path-scoped deny for tests/ + logs/ — modern 2.4 authz via <If>. On legacy
# Apache 2.2 (<If> unsupported) the RewriteRule [F] rule above is the fallback.
<IfModule mod_authz_core.c>
    <If "%{REQUEST_URI} =~ m#^/EE/(tests|logs)(/|$)#">
        Require all denied
    </If>
</IfModule>

# Set proper headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    # CSP built from the domains actually referenced in the markup:
    # scripts: unpkg (Leaflet), cdn.jsdelivr (Chart.js), accounts.google.com (GSI);
    # styles: cdnjs (Font Awesome), unpkg, fonts.googleapis, accounts.google.com (GSI injects
    # its own stylesheet into the login page); fonts: fonts.gstatic;
    # images: Leaflet marker PNGs (unpkg), OpenStreetMap tiles + Google profile avatars; XHR: self + Nominatim.
    # 'unsafe-inline' is required for script-src/style-src: the app uses inline
    # event handlers (onclick=...) and inline style attributes throughout.
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net https://accounts.google.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://unpkg.com https://fonts.googleapis.com https://accounts.google.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://unpkg.com https://*.tile.openstreetmap.org https://*.googleusercontent.com; connect-src 'self' https://nominatim.openstreetmap.org https://accounts.google.com; frame-src https://accounts.google.com"
</IfModule>
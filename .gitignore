# Uploaded user photos/logos — never commit
public/assets/uploads/

# Runtime logs — never commit
/logs/

# Google OAuth credential downloads — never commit
client_secret_*.json

# Composer binary — local tool, not project code
composer.phar

# Environment secrets — never commit
.env

# App runtime logs (app/logs was historically committed — never again)
app/logs/

# Key material — nothing in this project should ever track these
*.pem
*.key

# Integration-test curl cookie jars — regenerated per run, never commit
tests/*.txt
